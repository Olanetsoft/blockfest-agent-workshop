# Get a free key at https://aistudio.google.com/apikey and paste it here.
API_KEY=paste-your-key-here

# Use a model that AI Studio lists as free for your account.
MODEL=gemini-3.8-flash
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# To run a model on your own laptop with Ollama (https://ollama.com), use these three lines instead.
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=qwen3:4b

# Optional. With these set, send_message posts to Telegram. Without them, messages are saved in the outbox folder.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
