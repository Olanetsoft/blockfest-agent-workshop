# 1. Get a free key (no card needed): https://aistudio.google.com/apikey
API_KEY=paste-your-key-here

# 2. Pick a model that AI Studio lists as free for you today.
MODEL=gemini-3.8-flash
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# No internet? Run a model on your laptop with Ollama (https://ollama.com) instead:
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=qwen3:4b

# Optional. Lets send_message post to Telegram. Leave empty and messages go to outbox/.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
